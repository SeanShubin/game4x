# Moving one scout of two takes one, and the other stays where it was.
#
# **This is the `remove` half on its own.** The destination is empty, so what lands there is right
# either way - what this asks is whether leaving took one or took the row.

{test name:one-scout-of-two-leaves-and-one-stays}

{given}
{territory id:1}
{place id:1 of:1 layer:surface}
{territory id:2}
{place id:2 of:2 layer:surface}
{adjacency id:1 from:1 to:2}
{scout where:1 moving:1 quantity:2}

{when}
{move what:28 from:1 to:2}

{then}
{territory id:1}
{place id:1 of:1 layer:surface}
{territory id:2}
{place id:2 of:2 layer:surface}
{adjacency id:1 from:1 to:2}
{scout where:1 moving:1 quantity:1}
{scout where:2 moving:0 quantity:1}
