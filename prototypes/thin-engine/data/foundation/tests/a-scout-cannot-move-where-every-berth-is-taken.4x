# Six berths of six are taken and a seventh vehicle has nowhere to stand.
#
# **No rule mentions berths.** `move` puts the scout down and the world it would leave does not
# fit, which is where the refusal comes from - so the allowance binds every rule that puts a
# vehicle anywhere, including ones not written yet.

{test name:a-scout-cannot-move-where-every-berth-is-taken}

{given}
{territory id:1}
{territory id:2}
{adjacency id:1 from:1 to:2}
{scout where:1 quantity:1}
{transport where:2 quantity:3}

{when}
{move what:28 from:1 to:2}

{refused}
{pool name:berth per:13 n:7}
