# The rule: `move`, as inputs, clauses and bindings.
#
# **A clause says which relation and what to do with it; a binding says which column takes which
# input.** They are two relations because a clause cannot carry `residency`'s columns - those
# change with the relation it points at, and a relation's columns do not change.
#
# **A command names what is moved, not which row.** Scouts are fungible, so `what` is the category
# and `from` is what picks the row out of the three a category may have. **There is no `it`**: a
# residency has no id to name, because it is keyed by its description.
#
# **`require` and `remove` are patterns; `add` is a whole row.** The adjacency clause names no id
# because it asks whether *any* road runs that way. **The add clause names every column, and the
# quantity is the one no caller supplies** - an input is typed as a relation and carries one of its
# keys, so a plain number cannot be one. `{literal ...}` is where it comes from, which is what
# `releases/first-release.md` does with a **Qty** written in the recipe.

{rule id:1 name:move}

{input id:1 rule:move seq:1 name:what of:thing}
{input id:2 rule:move seq:2 name:from of:territory}
{input id:3 rule:move seq:3 name:to of:territory}

{clause id:1 rule:move seq:1 role:require relation:residency name:clause-1}
{clause id:2 rule:move seq:2 role:require relation:adjacency name:clause-2}
{clause id:3 rule:move seq:3 role:remove relation:residency name:clause-3}
{clause id:4 rule:move seq:4 role:add relation:residency name:clause-4}

{binding id:1 clause:clause-1 column:44 input:what}
{binding id:2 clause:clause-1 column:45 input:from}

{binding id:3 clause:clause-2 column:42 input:from}
{binding id:4 clause:clause-2 column:43 input:to}

{binding id:5 clause:clause-3 column:44 input:what}
{binding id:6 clause:clause-3 column:45 input:from}

{binding id:7 clause:clause-4 column:44 input:what}
{binding id:8 clause:clause-4 column:45 input:to}

{literal id:1 clause:clause-4 column:46 value:1}
{literal id:2 clause:clause-3 column:46 value:1}

{rule id:2 name:build-extractor}

{input id:4 rule:build-extractor seq:1 name:where of:territory}
{input id:7 rule:build-extractor seq:2 name:for of:thing}

{clause id:5 rule:build-extractor seq:1 role:remove relation:residency name:clause-5}
{clause id:6 rule:build-extractor seq:2 role:remove relation:residency name:clause-6}
{clause id:8 rule:build-extractor seq:3 role:remove relation:free name:clause-8}
{clause id:7 rule:build-extractor seq:4 role:add relation:extractor name:clause-7}

{binding id:9 clause:clause-5 column:45 input:where}
{binding id:10 clause:clause-6 column:45 input:where}
{binding id:11 clause:clause-7 column:57 input:where}
{binding id:12 clause:clause-7 column:58 input:for}

{binding id:13 clause:clause-8 column:54 input:where}
{binding id:14 clause:clause-8 column:55 input:for}

{literal id:3 clause:clause-5 column:44 value:labor}
