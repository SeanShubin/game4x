{literal id:5 clause:clause-6 column:44 value:metal}
{literal id:6 clause:clause-6 column:46 value:1}
{literal id:8 clause:clause-7 column:59 value:1}
{literal id:9 clause:clause-8 column:56 value:1}

{rule id:3 name:work}

