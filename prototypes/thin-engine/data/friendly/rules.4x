{clause id:18 rule:build-bin seq:2 role:remove relation:metal name:clause-18}
{clause id:19 rule:build-bin seq:3 role:add relation:bin name:clause-19}

{binding id:30 clause:clause-17 column:78 input:where}
{binding id:31 clause:clause-18 column:80 input:where}

{binding id:32 clause:clause-19 column:118 input:where}
{binding id:33 clause:clause-19 column:119 input:what}

{literal id:20 clause:clause-17 column:79 value:1}
{literal id:21 clause:clause-18 column:81 value:1}
