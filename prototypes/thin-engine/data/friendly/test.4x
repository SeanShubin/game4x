# The orchestrator: what this test does, in the order it does it.
#
# **A test is data too.** Nothing here is Rust - the harness reads this file, and every step is a
# row. `seq` orders them across the four step relations, and is read as a number rather than as
# text, because `10` sorts before `2`.

{test id:1 name:the-scout-moves-to-an-adjacent-place}

{load id:1 seq:1 file:script.4x into:script}
{load id:2 seq:2 file:schema.4x into:game}
{load id:3 seq:3 file:engine.4x into:game}
{load id:4 seq:4 file:rules.4x into:game}
{load id:5 seq:5 file:before.4x into:game}
{load id:6 seq:6 file:command.4x into:game}
{load id:7 seq:7 file:expected.4x into:expected}

{execute id:1 seq:8 command:1}
{compare id:1 seq:9 this:actual with:expected}
{report id:1 seq:10 title:the-first-test}
