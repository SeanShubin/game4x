# Five berths of six are taken and a scout moves in, which is the sixth.
#
# **The control for the two beside it.** Both of those refuse a move into a full territory, and a
# refusal proves nothing unless something otherwise like it is allowed.

{test name:a-scout-moves-where-there-is-a-berth-to-spare}

{given}
{territory id:1 name:territory-1}
{territory id:2 name:territory-2}
{adjacency id:1 from:territory-1 to:territory-2}
{scout where:territory-1} -> 1
{transport where:territory-2} -> 2
{scout where:territory-2} -> 1

{when}
{move what:scout from:territory-1 to:territory-2}

{then}
{territory id:1 name:territory-1}
{territory id:2 name:territory-2}
{adjacency id:1 from:territory-1 to:territory-2}
{transport where:territory-2} -> 2
{scout where:territory-2} -> 2
