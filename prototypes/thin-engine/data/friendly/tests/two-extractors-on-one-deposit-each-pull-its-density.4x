# Two extractors on one deposit, worked twice, pull the density twice.
#
# **The density is the deposit's, not the extractor's.** Nothing divides it between them and
# nothing about the second differs from the first, which is what makes twelve rather than six.

{test name:two-extractors-on-one-deposit-each-pull-its-density}

{given}
{territory id:1 name:territory-1}
{density where:territory-1 what:food} -> 6
{extractor where:territory-1 for:food} -> 2
{residency what:labor where:territory-1} -> 2

{when}
{work where:territory-1 for:food}
{work where:territory-1 for:food}

{then}
{territory id:1 name:territory-1}
{density where:territory-1 what:food} -> 6
{extractor where:territory-1 for:food} -> 2
{residency what:food where:territory-1} -> 12
