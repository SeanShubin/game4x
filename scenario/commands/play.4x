# The main scenario: a typical game, from orbit to an Ark leaving a developed planet.
#
# `spec/scenarios.md`: there is one main scenario and it touches everything a typical game
# uses. It is the foundation, and it is vetted by hand. A mechanic that only appears in an
# unusual situation belongs in a scenario of its own - so nothing here starves and nothing
# is lost to nature, and both get scenarios of their own once this one satisfies its reader.
#
# Every line is a command. There is no other way for the state to move, so this file is a
# complete account of how the game got where `scenario/expected/play.4x` says it is.
#
# **Storage is the constraint now** - `S-44`. A territory declares no capacity for a
# resource; it holds what its stores hold, and a store holds ten. An extractor holds
# nothing, so what is produced goes into a store, is spent the turn it is made, or is lost
# when that turn ends. A founding leaves a food store and a metal store and no energy store,
# which is why energy is the resource this game has to build for.

# Turn 1. The Ark lands on territory 1 and becomes the ground: a garrison, two citizens, a
# farm, a mine, and somewhere to put what each of them digs.
land ark 1
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 metal
end turn

# Turn 2. Four citizens. The food store holds ten and the farm makes six, so the second farm
# has to wait for somewhere to put its harvest - which is the shape of every turn from here.
create labor 1 1
work 1 extractor 1 food
create labor 1 1
build store 1 food
create labor 1 1
build extractor 1 food
end turn

# Turn 3. Two farms into two stores, and the mine pays for the next of each.
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 metal
create labor 1 1
build store 1 food
end turn

# Turn 4. The last of the farms the ground has room for, and the second mine.
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
build extractor 1 food
create labor 1 1
build extractor 1 metal
create labor 1 1
build store 1 food
end turn

# Turn 5. The ground is nearly worked out. Energy is the resource this planet has to build
# for: one node, no store from the founding, and an Ark wants twelve.
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 metal
create labor 1 1
work 1 extractor 1 metal
create labor 1 1
build extractor 1 energy
create labor 1 1
build store 1 energy
create labor 1 1
build store 1 metal
end turn

# Turn 6. Everything worked, and the first turn where energy has somewhere to go.
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 metal
create labor 1 1
work 1 extractor 1 metal
create labor 1 1
work 1 extractor 1 energy
create labor 1 1
build extractor 1 food
end turn

# Turn 7. A pioneer costs three metal and six energy, and both are in store now.
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 metal
create labor 1 1
work 1 extractor 1 metal
create labor 1 1
work 1 extractor 1 energy
create labor 1 1
produce pioneer 1
end turn

# Turn 8. The pioneer crosses into territory 2 and becomes it. `P-214`: the player says which
# recipe this is, because arriving on unclaimed ground and arriving on your own are two
# recipes and the model no longer guesses from the ground which was meant.
found by land 2
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 metal
create labor 1 1
work 1 extractor 1 metal
create labor 1 1
work 1 extractor 1 energy
create labor 1 2
work 1 extractor 2 food
end turn

# Turn 9. Fifteen metal is two stores' worth and change, so the Yard lands here.
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 energy
create labor 1 1
build yard 1
create labor 1 2
work 1 extractor 2 food
end turn

# Turn 10. Nothing left to build. Energy is all that stands between here and an Ark, and one
# node at density three fills its single store four turns at a time.
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 metal
create labor 1 1
work 1 extractor 1 energy
create labor 1 2
work 1 extractor 2 food
end turn

# Turn 11.
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 metal
create labor 1 1
work 1 extractor 1 energy
create labor 1 2
work 1 extractor 2 food
end turn

# Turn 12. The Ark, and it is only affordable because of `P-270`: a resource in nothing can
# be spent the turn it is made. The store holds ten and the Ark wants twelve, so the three
# dug this turn are the difference between leaving and never leaving.
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 metal
create labor 1 1
work 1 extractor 1 energy
create labor 1 1
produce ark 1
create labor 1 2
work 1 extractor 2 food

# The Ark crosses to territory 2 before it leaves, which is the only `move` in this file -
# ground already yours, which is the whole difference between the two recipes.
move ark 2
end turn

# Turn 13. Moving exhausts a unit, so the Ark leaves on the turn after the one it crossed on.
# The farms are worked first, as always: a population that gathers nothing starves at the end
# of the turn, whatever else is going on.
create labor 1 1
work 1 extractor 1 food
create labor 1 1
work 1 extractor 1 food
create labor 1 2
work 1 extractor 2 food
launch ark
end turn
