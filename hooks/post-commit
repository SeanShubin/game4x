#!/bin/sh
# Leave nothing of this lane's in the shared index.
#
# `pre-commit` regenerates pending.md and stages it, because it is derived from the outboxes
# and a stale copy is worth less than no copy. That is right for an ordinary commit, where
# the index is what gets committed and pending.md goes with it.
#
# It is wrong after a pathspec commit - `git commit -- some/path` - which commits the paths
# named from the working tree and leaves the rest of the index alone. pending.md then sits
# staged and uncommitted, and the next `git commit` in this tree takes it, whoever runs it
# and whatever their commit is about. Three perspectives share this working tree, so the
# next commit is often another lane's, and it would carry a pending.md rendered from
# outboxes as they stood during somebody else's session - reverting findings filed since,
# under a message about something else.
#
# That is the hazard CLAUDE.md states plainly: a file you stage is committed by whoever
# commits next. It has already happened once here, with twenty-six lines landing in another
# perspective's commit. The quality lens found this instance of it.
#
# Resetting is safe in both directions. After an ordinary commit the index already matches
# HEAD for this path and this does nothing. After a pathspec commit it unstages the
# regenerated file, which stays in the working tree - visible in `git status`, belonging to
# whoever produced it, and picked up by the next commit's own hook run.
#
# Enable once per clone: git config core.hooksPath hooks
set -e

# **No pager, ever.** Every `git diff` in this file has its output captured or is `--quiet`,
# so none of them pages today - and that is a property of how each call happens to be
# written rather than of anything enforced. An uncaptured one added later would page, and a
# hook that pages hangs the commit waiting for somebody to press q.
#
# `scripts/push.sh` is where this actually bit: a bare `git log` paged, and a push stopped in
# the middle to wait for a keypress. Set here for the same reason it is set there, and
# `tools/hooks/tests/no_pager.rs` is what says every script in this tree has it.
export GIT_PAGER=cat

if ! git diff --cached --quiet -- pending.md 2>/dev/null; then
    echo "post-commit: pending.md was left staged by a pathspec commit; unstaging it"
    echo "post-commit: the regenerated file stays in the working tree - it is not lost"
    git reset --quiet -- pending.md
fi

# Say what a pathspec commit left staged, because the next commit takes it.
#
# **`S-166`, and `pending.md` above is one instance of it.** `pre-commit` stages what it
# changes - the regenerated index, and every markdown file `tools/pad-tables` repads - and a
# pathspec commit takes the working tree rather than the index, so whatever the hook staged is
# still staged afterwards. **The next `git commit` in this tree takes it**, whoever runs it and
# whatever their commit is about, which is the hazard the paragraph above already states in
# general and then guards for exactly one file.
#
# **It produced a real one on 2026-09-24.** `crates/game-inspect/README.md` was committed as I
# had padded it by hand, and the padder's version - differing from both `HEAD` and the working
# tree - was left in the index.
#
# **Reported rather than unstaged, and the difference matters.** Unstaging is right for
# `pending.md`, which is generated, belongs to nobody, and stays in the working tree. It is
# wrong here: in that instance the **index held the correct file and the working tree held the
# wrong one**, so unstaging would have left a README the padder disagrees with and broken
# `tools/pad-tables`'s own check later, one lane over.
#
# **And this lane's own form cannot produce it** - the specification lane measured that: staging
# by name and committing with no pathspec takes the index, so the hook's changes land. So the
# hazard is specific to `git commit <pathspec>`, which is the form the refusal message in
# `pre-commit` recommends for getting out of a two-column index. **The two guards point in
# opposite directions**, and that is worth a reader knowing rather than discovering.
stranded=$(git diff --cached --name-only)
if [ -n "$stranded" ]; then
    echo "post-commit: these are staged and were not in that commit:" >&2
    echo "$stranded" | sed 's/^/  /' >&2
    echo "post-commit: a pathspec commit takes the working tree, so what pre-commit staged is" >&2
    echo "post-commit: still staged - and the next commit in this tree takes it, whoever runs" >&2
    echo "post-commit: it. Commit them or unstage them; do not leave them for somebody else." >&2
fi

# Say when a commit spanned two columns after all, which `pre-commit` cannot catch.
#
# **`pre-commit` refuses that shape and it cannot be enough.** It reads the index, returns,
# and *then* git reads the index to build the tree - and nothing runs in between. A `git add`
# from another lane landing in that instant puts a file into a commit the hook already
# approved. The hook is not wrong; it is early.
#
# **It happened on 2026-09-21.** `b055da2b` is a promotion of the specification lane's
# carrying twenty lines of `crates/game-console/tests/first_release.rs`, which was this lane's,
# staged seconds before and still uncommitted when its author hit the index lock. The work
# survived and the commit message was lost, which `CLAUDE.md` records happening twice before.
#
# **My first version of this comment said nothing had said so, and that was wrong.** The
# specification lane went and looked: that commit's output ends *pre-commit: rustfmt on staged
# Rust files*, and `pre-commit` prints that line only when `staged '*.rs'` is non-empty - on a
# promotion that should have carried two markdown files and nothing else. **The hook told it
# and it read past.** So the record was silent and the terminal was not, which are two
# different claims and only the first is true.
#
# **That strengthens the case for this check rather than weakening it.** A tell somebody has
# to notice is exactly what a check exists to replace, and this one needs nobody to spot an odd
# line in twenty of output.
#
# **And it located the window, which was the more useful half.** The line proving Rust was
# staged is printed near the end of `pre-commit`, where the column check runs near the start -
# so the file arrived during the hook's own run, not after it. `pre-commit` now checks the
# columns a second time before returning, which removes those seconds.
#
# **What is left is detection, and that is all anything can be.** Nothing runs between the
# hook returning and git reading the index, so a commit can still be raced in that instant.
# The commit exists either way; what changes is that a lane is told at once rather than finding
# out later or never.
#
# **`column_of` is read out of `pre-commit` rather than copied.** A second copy is the thing
# being checked written twice, and the copy is what rots - which is the argument
# `tools/hooks/src/lib.rs` already makes for extracting the same function by text.
root=$(git rev-parse --show-toplevel)
if [ -f "$root/hooks/pre-commit" ]; then
    eval "$(sed -n '/^column_of() {/,/^}$/p' "$root/hooks/pre-commit")"
    landed=$(git show --name-only --format= HEAD | grep . || true)
    columns=""
    for file in $landed; do
        column=$(column_of "$file")
        if [ -n "$column" ]; then
            case " $columns " in
                *" $column "*) ;;
                *) columns="$columns $column" ;;
            esac
        fi
    done
    set -- $columns
    if [ "$#" -gt 1 ]; then
        echo "post-commit: this commit spans $# perspectives' columns:" >&2
        for file in $landed; do
            column=$(column_of "$file")
            if [ -z "$column" ]; then column="(unassigned)"; fi
            echo "  $column  $file" >&2
        done
        echo "post-commit: pre-commit approved an index that changed before git read it -" >&2
        echo "post-commit: somebody else's git add landed in the gap. The work is committed" >&2
        echo "post-commit: and nothing is lost; what is wrong is the message it landed under." >&2
        echo "post-commit: Say so, and never amend - CLAUDE.md: a hash is the one citation" >&2
        echo "post-commit: here that cannot be re-derived." >&2
    fi
fi
