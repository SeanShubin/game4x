#!/bin/sh
# The cheap half of CI, run before anything leaves the machine.
#
# It mirrors the gate job in .github/workflows/pipeline.yml minus the WASM build, which
# needs Trunk and a wasm32 toolchain and takes long enough to belong in CI. The point is
# that the two failures worth catching locally - a formatting slip and broken geometry -
# are found in seconds rather than after a round trip through GitHub Actions.
#
# Release mode is deliberate: the tessellation tests relax hundreds of seeds and are
# unusably slow unoptimized.
#
# Enable once per clone: git config core.hooksPath hooks
# Skip a single push:    git push --no-verify
set -e

echo "pre-push: cargo fmt --all -- --check"
cargo fmt --all -- --check

# **`--all-targets`, so that "everything" means it** - `Q-82`. Without it clippy lints no
# `tests/` target and no `#[cfg(test)]` module inside `src/`, which is most of the assertions
# in this repository. Seventeen findings were living there when the quality lens measured it,
# across eight files, and the gate was green the whole time.
#
# The lesson had already been learned forty lines down, for the tools, and applied only
# there: something *linted and format-checked by nothing, and carrying a live clippy warning
# that no gate could see*. Same sentence, same file, the other half of the tree.
echo "pre-push: cargo clippy (everything, tests included)"
cargo clippy --workspace --all-targets -- -D warnings

# Selected by exclusion, deliberately. A list of crates to *include* goes stale silently
# every time a crate is added or split: planet-terrain was missing from it when it landed,
# and splitting planet-bevy moved seven tests into planet-flat, which nothing named - so
# they ran only after the page was published, and nothing failed to say so. Twice in two
# days, which makes it the mechanism rather than anyone's attention.
#
# Excluding makes coverage the default. This list is wrong only when somebody deliberately
# removes a name, and the thing it names is one fact: does the crate link an engine.
# **On one line, and that is not a style choice.** This was wrapped with `\` continuations and
# one of them arrived as a literal `\n` - two characters, inside double quotes, where a line
# break was meant. `$ENGINE` is expanded unquoted, so that word reached `cargo test` as a
# positional argument, and a positional argument to `cargo test` is the **test-name filter**.
# Nothing is named `\n`, so the release suite compiled fifty test binaries, ran **0 of 638
# tests**, and printed `test result: ok` fifty times. Introduced at `2a5a030b` on 2026-09-22.
#
# `.github/workflows/pipeline.yml` carries the same list on one line and has been running those
# tests the whole time, so nothing shipped unchecked. What was blind is the gate a lane runs
# before it commits - the one it quotes when it says *green*.
ENGINE="--exclude planet-ecs --exclude planet-bevy --exclude planet-flat --exclude game-globe --exclude game4x --exclude planet-view --exclude goldberg-view --exclude goldberg-move"

# **`ok` over nothing is `ok`, so a suite says how many tests it ran and zero is red.**
#
# `CLAUDE.md`: *a count over nothing is the same failure with the sign flipped*, and *a check
# whose subject is behaviour reads the outcome, not the input.* Checking that the exclude list
# is well formed would read what was written; this reads what ran, which is what was false.
#
# **It is not about backslashes.** Anything reaching `cargo test` as a positional argument
# becomes the filter, whatever put it there, and cargo calls a fully filtered run a pass
# because from its own side it is one.
#
# The verdict travels in a file because the group runs in a subshell to the left of `tee`, and
# `$?` after a pipeline is `tee`'s. Output still streams, so a long suite stays watchable.
suite() {
    label=$1
    shift
    work=$(mktemp -d)
    { "$@" 2>&1 && echo green > "$work/verdict"; } | tee "$work/log"
    [ -f "$work/verdict" ] || { echo "pre-push: $label failed, above." >&2; exit 1; }
    ran=$(sed -n 's/^test result:.* \([0-9][0-9]*\) passed.*/\1/p' "$work/log" |
        awk '{ n += $1 } END { print n + 0 }')
    if [ "$ran" -eq 0 ]; then
        echo "pre-push: $label compiled and ran 0 tests, which is not a pass." >&2
        echo "          A stray word in the argument list is cargo's test-name filter." >&2
        exit 1
    fi
    echo "pre-push: $label - $ran test(s) ran"
    rm -rf "$work"
}

# Release for the rest, because the tessellation tests relax hundreds of seeds and are
# unusably slow unoptimized.
# **`--no-fail-fast`, because cargo stops at the first failing binary** - `Q-92`. Without it
# a run reports one failure and hides every other, so *the gate is red on X* was true and
# incomplete for two days in all three lanes. Measured at `ab33689`: one failure with it off
# and eleven with it on, reducing to four causes. The count was never the number anybody
# quoted; it was the first one cargo happened to reach.
#
# **A flag rather than a habit.** `CLAUDE.md` prefers a carrier, or better a default path on
# which a rule cannot be broken, and reading past the first failure is exactly the sort of
# habit that fires at a moment of confidence and not otherwise.
#
# **The other masking is left alone deliberately.** This runs under `set -e`, so a failing
# `cargo fmt` still hides the tests entirely. That ordering is cheap to remember and is the
# point of running fmt first; masking *within* one run is neither.
# **`--all-targets`, because without it the tests inside an example never run.** `cargo test`
# builds an example and does not run its `#[cfg(test)] mod tests` - so the eight in
# `crates/game-model/examples/review-web.rs` had never run here. **Seven of the eight were red**
# when they were first run on 2026-10-03, and one of them would have caught a record being written
# with the wrong `{test name:}` the moment `S-256` landed.
#
# **It is the one target kind nothing covered.** `clippy` above already passes `--all-targets`, so
# the examples compile on every push and only their assertions were invisible - which is why this
# looked like a suite that ran.
echo "pre-push: cargo test --release (everything that does not link an engine)"
suite "the release suite" cargo test --release --all-targets --no-fail-fast --workspace $ENGINE

# Debug for the engine-facing ones: clippy above has just compiled them unoptimized, so
# this reuses that build rather than paying for a release build of Bevy. They used to run
# only in the job that reports after the page is already published, which is a strange
# place to keep a regression test for a bug that shipped once.
# tools/ is outside the workspace, so --workspace does not reach it and its tests ran only
# when somebody typed this path. One of them checks that every crate has a row in
# docs/architecture.md, and in the six weeks it was unwired the table went stale twice with
# nothing to say so - C-12. A check nobody runs has no answer, and no answer looks exactly
# like a right one.
# **Found rather than listed** - Q-46. Each tool declares its own `[workspace]` so it stays
# out of `cargo tree` and `cargo build --workspace`, which is deliberate and right; the cost
# is that `--all` and `--workspace` cannot reach any of them, so a gate has to name them. A
# name list goes stale the moment a fourth exists, and one had: `tools/spec` was tested,
# linted and format-checked by nothing, and was carrying a live clippy warning that no gate
# could have caught. **The tool whose tests exist to catch unverified claims was the one
# nothing verified.**
#
# This is Q-37 in the one place that fix could not reach: coverage is the default now, and
# leaving a tool out is an explicit act rather than a name somebody forgot to add.
echo "pre-push: the documentation tools"
for manifest in tools/*/Cargo.toml; do
    echo "  $manifest"
    cargo fmt --manifest-path "$manifest" -- --check
    suite "$manifest" cargo test --no-fail-fast --manifest-path "$manifest"
    # **The `tools/spec` exception is gone, and it expired the way one should.** It said
    # clippy was skipped there because the file carried a live `collapsible_if` this lane
    # may not edit - Q-46, reported to the lane that owns it. `11cf365` fixed it, and the
    # exception was checked rather than assumed: `--all-targets -- -D warnings` against that
    # manifest is clean, so the thing the exception was excusing has stopped existing.
    #
    # **A named exception that cannot outlive its excuse** - C-61's shape. What made this one
    # safe to remove is that removing it is what tests the claim: if anything were still
    # there, the gate says so at once and names it.
    cargo clippy --manifest-path "$manifest" --all-targets -- -D warnings
done

echo "pre-push: cargo test (the engine-facing crates)"
suite "the engine-facing crates" cargo test --no-fail-fast -p planet-ecs -p planet-bevy \
  -p planet-flat -p game-globe -p game4x -p planet-view -p goldberg-view -p goldberg-move
