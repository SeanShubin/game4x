#!/bin/sh
# Formats what you have staged, then re-stages it: markdown tables get padded, Rust gets
# rustfmt. So a table can never be committed misaligned, and a formatting slip can never
# cost a whole CI run - `cargo fmt --all -- --check` is the first thing the pipeline does.
#
# Commits stay manual: this only touches files you have already staged, formats them in
# place, and re-stages the result. It does not commit for you.
#
# Caveat, worth knowing before it bites: a partially staged file - some hunks staged, some
# not - gets fully re-staged after formatting, pulling its unstaged hunks in with it. If
# you stage whole files, this never happens.
#
# Enable once per clone: git config core.hooksPath hooks
set -e

staged() {
    git diff --cached --name-only --diff-filter=ACMR -- "$1"
}

files=$(staged '*.md')
if [ -n "$files" ]; then
    echo "pre-commit: padding markdown tables in staged files"
    echo "$files" | xargs cargo run --quiet --manifest-path tools/pad-tables/Cargo.toml --
    echo "$files" | xargs git add --
fi

# The one document that says what is pending, rewritten from the outboxes it is derived from.
# Generated rather than maintained: a hand-edited copy could disagree with its sources, and
# every hand-held habit in this repository has rotted while every generated artifact has held.
#
# Unconditional rather than only when an outbox is staged, because an outbox can change in a
# commit that does not touch one - a finding is closed by the commit that acts on it, and
# that commit is about code.
#
# Only when every outbox is committed or staged. The generator reads the working tree, so
# regenerating over somebody's half-written finding would render it into pending.md and
# stage it into this commit - publishing another perspective's draft, under a commit that
# touches nothing of theirs, to the one document Sean opens. That is `git add -A` wearing a
# different name, and it is forbidden a few lines further up this file for exactly the
# reason it would bite here: three perspectives share this working tree, and another's work
# is usually uncommitted in it.
#
# Refusing is the safe direction. A stale pending.md that says so is recoverable by the next
# commit; a published draft is not recoverable at all, because the lane that wrote it does
# not know it went out.
outboxes="docs/notes/proposals.md crates/outbox.md lenses"
unstaged=$(git diff --name-only -- $outboxes)
if [ -n "$unstaged" ]; then
    echo "pre-commit: NOT rewriting pending.md - an outbox has unstaged changes:"
    echo "$unstaged" | sed 's/^/  /'
    echo "pre-commit: stage or stash them and commit again to bring pending.md up to date"
else
    echo "pre-commit: rewriting pending.md from the outboxes"
    cargo run --quiet --manifest-path tools/outbox/Cargo.toml -- --write >/dev/null
    git add pending.md

    # An item is closed by whoever filed it and answered by somebody else, so the filer
    # gets no signal and pending.md goes on naming settled questions. C-1, C-2 and C-3 sat
    # open for a day that way. The signal already existed - the workflow has a producer
    # cite the id in the commit that acts on the item - and nothing read it.
    #
    # Printed rather than refused. Every lane commits in this tree, and failing one lane's
    # commit because another lane has not closed an item would be the wrong perspective
    # paying. It is in pending.md as well, which is the copy that lasts.
    settled=$(cargo run --quiet --manifest-path tools/outbox/Cargo.toml -- --settled 2>/dev/null | grep -v "outboxes read" | grep -v "^$" || true)
    case "$settled" in
        ""|"nothing open"*) ;;
        *)
            echo "pre-commit: an open item is cited by a commit that did not touch its outbox:"
            echo "$settled" | sed 's/^/  /'
            echo "pre-commit: close it, or record the hash with **cited** so this stops asking"
            ;;
    esac
fi

# The edition is passed explicitly because rustfmt is invoked directly rather than through
# `cargo fmt`, which would reformat the whole workspace rather than only what is staged.
rust=$(staged '*.rs')
if [ -n "$rust" ]; then
    echo "pre-commit: rustfmt on staged Rust files"
    echo "$rust" | xargs rustfmt --edition 2024
    echo "$rust" | xargs git add --
fi
