#!/bin/sh
# Formats what you have staged, then re-stages it: markdown tables get padded, Rust gets
# rustfmt. So a table can never be committed misaligned, and a formatting slip can never
# cost a whole CI run - `cargo fmt --all -- --check` is the first thing the pipeline does.
#
# Commits stay manual: this only touches files you have already staged, formats them in
# place, and re-stages the result. It does not commit for you.
#
# Caveat, worth knowing before it bites: a partially staged file - some hunks staged, some
# not - gets fully re-staged after formatting, pulling its unstaged hunks in with it. If
# you stage whole files, this never happens.
#
# Enable once per clone: git config core.hooksPath hooks
set -e

# **`P-352`: refuse a commit whose files span two perspectives' columns.**
#
# `CLAUDE.md` -> Perspectives gives each instance a column and says nobody writes outside
# their own. Two different failures put files from two columns into one commit, and this
# refuses both:
#
# - **Writing outside your own column**, which is the rule stated directly.
# - **The shared-index race**, which is the one care cannot close. `git add` writes to an
#   index all three perspectives share and `git commit` commits the index rather than the
#   caller's changes, so a file you stage is committed by whoever commits next. Staging by
#   name bounds what you *add* and not what you *commit*. It has happened twice - twenty-six
#   lines, then twenty-one - and both times the swallowing commit spanned two columns, which
#   is what makes it detectable here when no amount of care was going to close the window.
#
# **What this sees is what will be committed**, in both commit shapes. An ordinary commit
# commits the index and the hook sees the index; a pathspec commit - `git commit -- <paths>` -
# commits those paths and the hook sees only those. Verified rather than assumed: with a file
# staged and a pathspec commit of another, this listed only the pathspec's.
#
# A file nobody owns is exempt rather than a column of its own. `pending.md` is generated from
# every outbox and belongs to no perspective, so a commit carrying it spans nothing.
column_of() {
    case "$1" in
        pending.md) echo "" ;;
        spec/*|releases/*|docs/*|README.md|CLAUDE.md) echo "spec" ;;
        tools/spec|tools/spec/*) echo "spec" ;;
        lenses/*)
            echo "lens:$(printf '%s' "$1" | cut -d/ -f2)" ;;
        tools/*)
            # A lens writes `tools/<its name>`; everything else under tools/ is production
            # support and the code lane's. Asked of the tree rather than listed, because a
            # list of lenses goes stale the day a fourth one starts - Q-46's lesson, one
            # directory over.
            name=$(printf '%s' "$1" | cut -d/ -f2)
            if [ -d "lenses/$name" ]; then echo "lens:$name"; else echo "code"; fi ;;
        temporary-notes/*) echo "sean" ;;
        crates/*|web/*|commands/*|prototypes/*|scenario/*|reports/*) echo "code" ;;
        hooks/*|scripts/*|.github/*|Cargo.toml|Cargo.lock|.gitignore) echo "code" ;;
        # **Unassigned rather than guessed.** A path this does not recognise is new, and
        # naming a column for it here would be this hook deciding something `CLAUDE.md` says.
        # It is listed in a refusal and never causes one.
        *) echo "" ;;
    esac
}

about_to_commit=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$about_to_commit" ]; then
    columns=""
    for file in $about_to_commit; do
        column=$(column_of "$file")
        # An explicit `if` rather than `[ ... ] && continue`, because `set -e` is on and a
        # false test at the end of a loop body is a failing command. It happens to be
        # tolerated; a hook that gates every lane's commits should not rest on that.
        if [ -n "$column" ]; then
        case " $columns " in
            *" $column "*) ;;
            *) columns="$columns $column" ;;
        esac
        fi
    done
    # `set --` rather than an array, because this is `sh`.
    set -- $columns
    if [ "$#" -gt 1 ]; then
        echo "pre-commit: REFUSED - this commit spans $# perspectives' columns:" >&2
        for file in $about_to_commit; do
            column=$(column_of "$file")
            if [ -z "$column" ]; then column="(unassigned)"; fi
            echo "  $column  $file" >&2
        done
        echo "pre-commit: CLAUDE.md -> Perspectives: nobody writes outside their own column," >&2
        echo "pre-commit: and a file you staged is committed by whoever commits next. If one" >&2
        echo "pre-commit: of these is not yours, it is somebody else's work about to land in" >&2
        echo "pre-commit: your commit - unstage it rather than committing it." >&2
        echo "pre-commit: Commit one column's files with: git commit -- <paths>" >&2
        exit 1
    fi
fi

# Run the outbox tool and say so if it could not run.
#
# **Three checks below were wired `... 2>/dev/null | grep … || true`.** If the tool failed -
# a compile error, a panic, a moved manifest - stderr went to the void, grep matched nothing,
# `|| true` succeeded, and the check reported nothing. **An empty answer from a tool that did
# not run reads exactly like an empty answer from a tool that found nothing**, and the hook
# went on to say the tree was clean.
#
# That is the shape C-43 records, found by the quality lens in my reporting and then by me in
# this file: a whole signal collapsed into a boolean that was true either way. **This class
# is survivable exactly to the degree that the wrong branch is loud**, so this one says which
# it took.
#
# **The tool's own codes are data and only the rest are failures.** 0 is clean, 1 is `--settled`
# and `--check` saying they found something, 2 is a blocking note. A panic or a cargo build
# failure is 101. Written the wrong way round first, and the control caught it: on a healthy
# tree `--settled` exits 1 because it had something to say, and this cried wolf over it.
outbox_says() {
    out=$(cargo run --quiet --manifest-path tools/outbox/Cargo.toml -- "$@" 2>/dev/null)
    status=$?
    if [ "$status" -gt 2 ]; then
        echo "pre-commit: \`outbox $*\` exited $status, so the check below reported nothing" >&2
        echo "pre-commit: that is the tool failing, not the tree being clean" >&2
        return 1
    fi
    printf '%s\n' "$out"
}

staged() {
    git diff --cached --name-only --diff-filter=ACMR -- "$1"
}

files=$(staged '*.md')
if [ -n "$files" ]; then
    echo "pre-commit: padding markdown tables in staged files"
    echo "$files" | xargs cargo run --quiet --manifest-path tools/pad-tables/Cargo.toml --
    echo "$files" | xargs git add --
fi

# The one document that says what is pending, rewritten from the outboxes it is derived from.
# Generated rather than maintained: a hand-edited copy could disagree with its sources, and
# every hand-held habit in this repository has rotted while every generated artifact has held.
#
# Unconditional rather than only when an outbox is staged, because an outbox can change in a
# commit that does not touch one - a finding is closed by the commit that acts on it, and
# that commit is about code.
#
# Only when every outbox is committed or staged. The generator reads the working tree, so
# regenerating over somebody's half-written finding would render it into pending.md and
# stage it into this commit - publishing another perspective's draft, under a commit that
# touches nothing of theirs, to the one document Sean opens. That is `git add -A` wearing a
# different name, and it is forbidden a few lines further up this file for exactly the
# reason it would bite here: three perspectives share this working tree, and another's work
# is usually uncommitted in it.
#
# Refusing is the safe direction. A stale pending.md that says so is recoverable by the next
# commit; a published draft is not recoverable at all, because the lane that wrote it does
# not know it went out.
# The list is asked for rather than written here, which is Q-62. It used to be a string, and
# the generator discovers releases/ and lenses/ by walking - so the two could not be kept in
# step by hand, and were not: releases/ was read and unguarded, which the quality lens
# demonstrated by putting a draft capability in releases/first-release.md and watching it
# land in pending.md inside an unrelated commit. The control was the same draft in
# lenses/quality/outbox.md, where the refusal fired, so the mechanism was right and only the
# list was wrong.
#
# One declaration, asked twice. A releases/second-release.md is guarded the moment it exists,
# with nobody having to remember.
#
# Untracked as well as unstaged: the generator reads the working tree, so a brand-new outbox
# nobody has added yet is read like any other, and `git diff` cannot see it.
outboxes=$(cargo run --quiet --manifest-path tools/outbox/Cargo.toml -- --places)
unstaged=$(git diff --name-only -- $outboxes; git ls-files --others --exclude-standard -- $outboxes)
if [ -n "$unstaged" ]; then
    echo "pre-commit: NOT rewriting pending.md - an outbox has unstaged changes:"
    echo "$unstaged" | sed 's/^/  /'
    echo "pre-commit: stage or stash them and commit again to bring pending.md up to date"
else
    echo "pre-commit: rewriting pending.md from the outboxes"
    cargo run --quiet --manifest-path tools/outbox/Cargo.toml -- --write >/dev/null
    git add pending.md

    # An item is closed by whoever filed it and answered by somebody else, so the filer
    # gets no signal and pending.md goes on naming settled questions. C-1, C-2 and C-3 sat
    # open for a day that way. The signal already existed - the workflow has a producer
    # cite the id in the commit that acts on the item - and nothing read it.
    #
    # Printed rather than refused. Every lane commits in this tree, and failing one lane's
    # commit because another lane has not closed an item would be the wrong perspective
    # paying. It is in pending.md as well, which is the copy that lasts.
    settled=$(outbox_says --settled | grep -v "outboxes read" | grep -v "^$" || true)
    case "$settled" in
        ""|"nothing open"*) ;;
        *)
            echo "pre-commit: an open item is cited by a commit that did not touch its outbox:"
            echo "$settled" | sed 's/^/  /'
            echo "pre-commit: close it, or record the hash with **cited** so this stops asking"
            ;;
    esac

    # P-250's second half, which had no mechanism until S-41: when an item moves to `acted`,
    # whatever lists the outboxes lists the open items naming the same rule. A rule that
    # moves under an open item makes it wrong without touching it - the item still reads
    # correctly, its evidence is still quoted accurately, and only its conclusion has
    # stopped being true.
    #
    # Printed beside the citation reconciliation because that output gets read: it is what
    # found the stale R-6 blocker. It makes the failure findable rather than found, which is
    # the limit promoted with the rule.
    # S-51's backstop. Reports and never gates - Q-60: a gate reddens for whichever lane
    # commits next, and that may be one which must not repair it. P-305's filing rule is the
    # mechanism; this catches the case where it was forgotten. Q-61 is why a row that reads
    # like a promotion is reported rather than believed.
    # Only the lines that name something wrong. The summary line carries the words "wrong
    # table" whether the count is zero or not, and matching it printed an alarming heading
    # over a clean result - which is how a check stops being read.
    orphans=$(outbox_says --orphans | grep -E "closed on .* which is withdrawn|^  misfiled:" || true)
    if [ -n "$orphans" ]; then
        echo "pre-commit: the withdrawn ledger and the closed items disagree:"
        echo "$orphans" | sed 's/^/  /'
    fi

        closing=$(outbox_says --closing | grep "derives from the same rule" || true)
    if [ -n "$closing" ]; then
        echo "pre-commit: an item closed, and these open items derive from its rule:"
        echo "$closing" | sed 's/^/  /'
        echo "pre-commit: re-derive each one, or say in it that the number still holds"
    fi

    # S-61, checking P-325: an item that cannot be acted on yet says what it waits on in a
    # field, and when that id is no longer open the wait is over. Four holds of the
    # specification lane's went stale in one night and the last stalled the file Sean was
    # waiting for - a hold in a paragraph is invisible to every tool and to every reader who
    # does not re-read the whole item.
    #
    # Reports and never gates, for the reason Q-60 settled for S-51: a gate reddens for
    # whichever lane commits next, and that may be a lane which must not repair it. The lane
    # that wrote the hold is the one that lifts it.
    #
    # Matched on the sentence rather than on the summary line, which carries the words
    # "waits are over" whether the count is zero or not - the same trap the orphans block
    # above records falling into.
    waiting=$(outbox_says --waiting | grep " waits on " || true)
    if [ -n "$waiting" ]; then
        echo "pre-commit: a hold is written on something that is no longer open:"
        echo "$waiting" | sed 's/^/  /'
        echo "pre-commit: lift it, or say in the item what it is waiting on now"
    fi
fi

# The edition is passed explicitly because rustfmt is invoked directly rather than through
# `cargo fmt`, which would reformat the whole workspace rather than only what is staged.
rust=$(staged '*.rs')
if [ -n "$rust" ]; then
    echo "pre-commit: rustfmt on staged Rust files"
    echo "$rust" | xargs rustfmt --edition 2024
    echo "$rust" | xargs git add --
fi
