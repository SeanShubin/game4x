{test name:an-extractor-cannot-be-built-where-the-deposits-are-taken}

{given}
{territory id:1}
{place id:1 of:1 layer:surface}
{capacity of:18 for:19 what:27 per:48 quantity:1}
{deposit where:1 what:31 density:6 quantity:1}
{extractor where:1 what:31 working:0 quantity:1}
{labor where:1 quantity:1}
{metal where:1 quantity:1}

{when}
{build-extractor what:31 where:1}

{refused}
{deposit where:1 what:31 quantity:2}
