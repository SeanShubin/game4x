{test name:breeding-does-not-give-a-citizen-its-labor-back}

{given}
{territory id:1}
{place id:1 of:1 layer:surface}
{provides kind:48 what:1 quantity:6}
{consumes kind:47 what:1 quantity:1}
{citizen where:1 hungry:0 bearing:1 laboring:0 quantity:1}
{food where:1 quantity:1}

{when}
{breed where:1}

{then}
{territory id:1}
{place id:1 of:1 layer:surface}
{provides kind:48 what:1 quantity:6}
{consumes kind:47 what:1 quantity:1}
{citizen where:1 hungry:0 bearing:0 laboring:0 quantity:1}
{citizen where:1 hungry:0 bearing:1 laboring:1 quantity:1}
