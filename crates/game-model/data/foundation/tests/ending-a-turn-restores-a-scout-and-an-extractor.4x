{test name:ending-a-turn-restores-a-scout-and-an-extractor}

{given}
{territory id:1}
{place id:1 of:1 layer:surface}
{capacity of:18 for:19 what:27 per:48 quantity:1}
{deposit where:1 what:31 density:6 quantity:2}
{extractor where:1 what:31 working:0 quantity:1}
{extractor where:1 what:31 working:1 quantity:1}
{scout where:1 moving:0 quantity:2}
{scout where:1 moving:1 quantity:1}

{when}
{end-turn}

{then}
{territory id:1}
{place id:1 of:1 layer:surface}
{capacity of:18 for:19 what:27 per:48 quantity:1}
{deposit where:1 what:31 density:6 quantity:2}
{extractor where:1 what:31 working:1 quantity:2}
{scout where:1 moving:1 quantity:3}
