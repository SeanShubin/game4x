{verdict state:approved}
{test name:a-citizen-breeds-once-and-its-bearing-is-spent}

{given}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{provides kind:place what:berth} -> 6
{consumes kind:citizen what:berth} -> 1
{citizen bearing:1 hungry:0 laboring:1 where:place-1} -> 1
{food where:place-1} -> 2

{when}
{breed where:place-1}

{then}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{provides kind:place what:berth} -> 6
{consumes kind:citizen what:berth} -> 1
{citizen bearing:0 hungry:0 laboring:1 where:place-1} -> 1
{citizen bearing:1 hungry:0 laboring:1 where:place-1} -> 1
{food where:place-1} -> 1
