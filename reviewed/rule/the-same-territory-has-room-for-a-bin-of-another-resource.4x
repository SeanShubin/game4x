{verdict state:approved}
{test name:the-same-territory-has-room-for-a-bin-of-another-resource}

{given}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{capacity of:place for:bin per:place what:metal} -> 2
{capacity of:place for:bin per:place what:food} -> 3
{bin what:metal where:place-1} -> 2
{labor where:place-1} -> 1
{metal where:place-1} -> 1

{when}
{build-bin what:food where:place-1}

{then}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{capacity of:place for:bin per:place what:metal} -> 2
{capacity of:place for:bin per:place what:food} -> 3
{bin what:metal where:place-1} -> 2
{bin what:food where:place-1} -> 1
