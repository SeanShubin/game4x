{verdict state:approved}
{test name:one-refresh-reaches-a-scout-and-a-transport}

{given}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{scout moving:0 where:place-1} -> 2
{scout moving:1 where:place-1} -> 1
{transport moving:0 where:place-1} -> 1
{transport moving:1 where:place-1} -> 2

{when}
{refresh trait:moving what:unit}

{then}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{scout moving:1 where:place-1} -> 3
{transport moving:1 where:place-1} -> 3
