{verdict state:approved}
{test name:a-pioneer-settles-the-ground-it-is-standing-on}

{given}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{capacity of:deposit for:extractor per:place what:resource} -> 1
{deposit density:6 what:metal where:place-1} -> 1
{deposit density:6 what:food where:place-1} -> 1
{pioneer moving:1 where:place-1} -> 1

{when}
{deploy what:pioneer where:place-1}

{then}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{capacity of:deposit for:extractor per:place what:resource} -> 1
{deposit density:6 what:metal where:place-1} -> 1
{deposit density:6 what:food where:place-1} -> 1
{extractor what:metal where:place-1 working:1} -> 1
{extractor what:food where:place-1 working:1} -> 1
{citizen bearing:1 hungry:0 laboring:1 where:place-1} -> 2
