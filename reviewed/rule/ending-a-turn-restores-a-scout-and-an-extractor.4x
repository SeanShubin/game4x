{verdict state:approved}
{test name:ending-a-turn-restores-a-scout-and-an-extractor}

{given}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{capacity of:deposit for:extractor per:place what:resource} -> 1
{deposit density:6 what:food where:place-1} -> 2
{extractor what:food where:place-1 working:0} -> 1
{extractor what:food where:place-1 working:1} -> 1
{scout moving:0 where:place-1} -> 2
{scout moving:1 where:place-1} -> 1

{when}
{end-turn}

{then}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{capacity of:deposit for:extractor per:place what:resource} -> 1
{deposit density:6 what:food where:place-1} -> 2
{extractor what:food where:place-1 working:1} -> 2
{scout moving:1 where:place-1} -> 3
