{verdict state:approved}
{test name:toil-works-the-unworked-citizens-of-one-place}

{given}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{territory name:territory-2 id:2}
{place name:place-2 of:territory-2 id:2 layer:surface}
{citizen bearing:0 hungry:1 laboring:1 where:place-1} -> 2
{citizen bearing:0 hungry:1 laboring:0 where:place-1} -> 1
{citizen bearing:1 hungry:1 laboring:1 where:place-2} -> 1

{when}
{toil where:place-1}

{then}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{territory name:territory-2 id:2}
{place name:place-2 of:territory-2 id:2 layer:surface}
{citizen bearing:0 hungry:1 laboring:0 where:place-1} -> 3
{citizen bearing:1 hungry:1 laboring:1 where:place-2} -> 1
{labor where:place-1} -> 2
