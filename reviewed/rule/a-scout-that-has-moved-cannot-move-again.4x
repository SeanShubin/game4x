{verdict state:approved}
{test name:a-scout-that-has-moved-cannot-move-again}

{given}
{territory name:territory-1 id:1}
{place name:place-1 of:territory-1 id:1 layer:surface}
{territory name:territory-2 id:2}
{place name:place-2 of:territory-2 id:2 layer:surface}
{adjacency id:1 from:territory-1 to:territory-2}
{adjacency id:2 from:territory-2 to:territory-1}
{scout moving:1 where:place-1} -> 1

{when}
{move from:place-1 to:place-2 what:scout}
{move from:place-2 to:place-1 what:scout}

{refused}
{scout moving:1 where:place-2} -> 1
